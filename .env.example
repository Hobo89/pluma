# Cal.com booking links
# Default event, e.g. "your-name/massage"
VITE_CALCOM_LINK=

# Optional: a separate event per session length. Set these only for lengths
# where the owner has created and verified a dedicated event.
VITE_CALCOM_LINK_30=
VITE_CALCOM_LINK_60=
VITE_CALCOM_LINK_90=
VITE_CALCOM_LINK_120=

# Set to "true" only if VITE_CALCOM_LINK points at a multi-duration event that
# has been confirmed to accept the `duration` query parameter.
VITE_CALCOM_MULTI_DURATION=

# Release states. All default to off. Turning one on asserts that the
# dependency in src/config/readiness.ts has actually been satisfied and
# recorded in OWNER-INPUTS.md. Do not enable these on the public site until
# then.
VITE_READY_BUSINESS=
VITE_READY_BOOKING=
VITE_READY_BONO_SALES=
VITE_READY_APPLE_WALLET=
VITE_READY_GOOGLE_WALLET=
VITE_READY_BALANCE_UPDATES=
